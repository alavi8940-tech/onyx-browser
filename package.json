{
  "name": "onyx-browser",
  "productName": "Onyx",
  "version": "1.0.0",
  "description": "مرورگر خصوصی، زیبا و بدون ردپا با پشتیبانی تور",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "ir.onyx.browser",
    "productName": "Onyx",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "maintainer": "alavi8940-tech",
      "artifactName": "onyx-${version}-${arch}.${ext}"
    }
  },
  "author": {
    "name": "alavi8940-tech"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
